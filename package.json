{
  "name": "circulos-de-cuidado",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.8.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/api run dev & npm --workspace apps/web run dev",
    "build": "npm --workspace apps/api run build && npm --workspace apps/web run build",
    "lint": "eslint . --ignore-pattern \"apps/web/dist/**\"",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^8.57.0",
    "eslint": "^8.57.0",
    "prettier": "^3.4.1"
  }
}
